    <defName>SQP_GoodNightVoice</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>SquadPTSD/GoodNightPrincess</clipPath>
          </li>
        </grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>1~1</pitchRange>
        <distRange>0~35</distRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
